{
  "schema_version": "vav-audio-replay-canary-v1",
  "case_id": "al-zaabi-real-kb-qa-interruption",
  "description": "Two-utterance QA fixture that interrupts the first response and checks complete recognition.",
  "target": {
    "mode": "browser_session",
    "api_base_url_env": "VAV_QA_API_BASE_URL",
    "api_token_env": "VAV_QA_API_TOKEN",
    "agent_id_env": "VAV_REAL_KB_QA_AGENT_ID",
    "variables": {
      "qa_replay": "real-kb-interruption-v1"
    }
  },
  "audio": {
    "path_env": "VAV_QA_BARGE_IN_AUDIO_FIXTURE_PATH",
    "format": "wav",
    "frame_ms": 20
  },
  "expectations": {
    "terminal_status": "completed",
    "transcript": {
      "utterances": [
        {
          "reference_text": "Tell me about Al Zaabi Group.",
          "max_word_error_rate": 0.2,
          "required_entities": [
            "Al Zaabi Group"
          ]
        },
        {
          "reference_text": "No, just tell me who the chairman is.",
          "max_word_error_rate": 0.15,
          "required_phrases": [
            "who the chairman is"
          ]
        }
      ],
      "max_extra_user_turns": 0
    },
    "latency": {
      "max_participant_active_to_first_server_speaking_ms": 1200,
      "max_turn_latency_p50_ms": 1200,
      "max_turn_latency_p90_ms": 1800,
      "max_turn_latency_p95_ms": 2000,
      "max_last_speech_end_to_first_audio_ms": 2000
    },
    "grounding": {
      "require_turn_diagnostics": true,
      "min_responses_after_verified_retrieval": 1,
      "max_unverified_answers": 0,
      "max_knowledge_errors": 0,
      "max_unexpected_script_turns": 0,
      "max_transcription_clarifications": 0
    },
    "interaction": {
      "min_barge_in_count": 1,
      "max_barge_in_count": 2,
      "max_suppressed_fragment_count": 0,
      "max_last_interruption_detection_ms": 250
    }
  },
  "timing": {
    "wait_for_remote_seconds": 30,
    "pre_roll_seconds": 2,
    "post_roll_seconds": 8,
    "finalization_timeout_seconds": 60,
    "poll_interval_seconds": 1
  },
  "safety": {
    "test_only": true,
    "allowlisted_agent_ids_env": "VAV_QA_REPLAY_ALLOWED_AGENT_IDS",
    "required_agent_name_markers": [
      "qa",
      "test",
      "canary"
    ],
    "max_fixture_duration_seconds": 45,
    "max_fixture_bytes": 10000000
  }
}
