# ============================================================
# Voice AI Agent Platform - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.
# ============================================================

# ---------------------
# General
# ---------------------
NODE_ENV=development
APP_NAME=VoiceAI
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
LOG_LEVEL=debug

# ---------------------
# Database (PostgreSQL)
# ---------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=voice_ai
DATABASE_USER=voice_ai_user
DATABASE_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---------------------
# Redis
# ---------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
REDIS_TLS=false

# ---------------------
# Authentication / JWT
# ---------------------
JWT_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret
JWT_REFRESH_EXPIRATION=7d
NEXTAUTH_SECRET=replace_with_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ---------------------
# Telephony - Twilio
# ---------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=${API_URL}/webhooks/twilio
TWILIO_STATUS_CALLBACK_URL=${API_URL}/webhooks/twilio/status

# ---------------------
# Telephony - Exotel
# ---------------------
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=

# ---------------------
# Telephony - Plivo
# ---------------------
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# ---------------------
# Telephony Provider (twilio | vonage | plivo | sip)
# ---------------------
TELEPHONY_PROVIDER=vonage

# ---------------------
# Telephony - Vonage
# ---------------------
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_FROM_NUMBER=

# ---------------------
# Telephony - SIP Trunk (Etisalat / du / generic)
# ---------------------
SIP_PROXY_HOST=                     # e.g., sbc.etisalat.ae
SIP_PROXY_PORT=5060                 # 5060 (UDP/TCP) or 5061 (TLS)
SIP_USERNAME=                       # SIP trunk username from provider
SIP_PASSWORD=                       # SIP trunk password from provider
SIP_DOMAIN=                         # e.g., sip.etisalat.ae
SIP_TRANSPORT=udp                   # udp | tcp | tls
SIP_CALLER_ID=                      # Your UAE number e.g., +97142345678
SIP_CODEC=PCMA                      # PCMA (G.711 A-law, standard in UAE/EU) | PCMU | G729
SIP_RTP_PORT_MIN=10000
SIP_RTP_PORT_MAX=20000
SIP_REGISTRATION_ENABLED=true
SIP_REGISTRATION_EXPIRY=3600

# ---------------------
# LLM - Anthropic
# ---------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=150

# ---------------------
# LLM - OpenAI
# ---------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# ---------------------
# LLM - Google
# ---------------------
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash
GOOGLE_AI_MAX_TOKENS=4096

# ---------------------
# Speech-to-Text (STT)
# ---------------------
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
GOOGLE_STT_CREDENTIALS_PATH=
AZURE_STT_KEY=
AZURE_STT_REGION=

# ---------------------
# Text-to-Speech (TTS)
# ---------------------
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
AZURE_TTS_KEY=
AZURE_TTS_REGION=
GOOGLE_TTS_CREDENTIALS_PATH=

# ---------------------
# S3 / MinIO (Object Storage)
# ---------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_access_key
S3_SECRET_KEY=minio_secret_key
S3_BUCKET_RECORDINGS=voice-ai-recordings
S3_BUCKET_ASSETS=voice-ai-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ---------------------
# SMTP / Email
# ---------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=VoiceAI Platform
SMTP_FROM_EMAIL=noreply@voiceai.local
SMTP_SECURE=false

# ---------------------
# Queue / Bull
# ---------------------
BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/admin/queues
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF=5000

# ---------------------
# Rate Limiting
# ---------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---------------------
# CORS
# ---------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------
# Encryption
# ---------------------
ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_aes256
ENCRYPTION_IV_LENGTH=16

# ---------------------
# Feature Flags
# ---------------------
FEATURE_MULTI_TENANT=true
FEATURE_CAMPAIGN_DIALER=true
FEATURE_REAL_TIME_MONITORING=true
FEATURE_COMPLIANCE_RECORDING=true
FEATURE_DNC_LIST=true
FEATURE_WEBHOOK_EVENTS=true

# ---------------------
# Sentry (Error Tracking)
# ---------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------
# Analytics
# ---------------------
POSTHOG_API_KEY=
POSTHOG_HOST=

# ---------------------
# WebSocket
# ---------------------
WS_PORT=4001
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL=30000
