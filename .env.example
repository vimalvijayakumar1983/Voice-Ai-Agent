# Database
DATABASE_URL=postgresql+asyncpg://voiceai:devpassword@localhost:5432/voiceai
DB_PASSWORD=devpassword

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# Required as a separate, identical sealed value on API and worker in production.
# Blank uses SECRET_KEY only for backwards compatibility.
INTEGRATION_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT signing and verification are deliberately restricted to HS256.
ALGORITHM=HS256
# Development may use open. Production must use bootstrap or invite_only.
REGISTRATION_MODE=open
# Required and canonicalized when REGISTRATION_MODE=bootstrap; never exposed by the API/UI.
BOOTSTRAP_OWNER_EMAIL=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM_NUMBER=

# Smallest.ai Atoms (server-side only; never expose this key in NEXT_PUBLIC_* variables)
SMALLEST_API_KEY=
SMALLEST_BASE_URL=https://api.smallest.ai/atoms/v1
SMALLEST_WEBHOOK_SECRET=
# Provider webhook ID whose secret matches SMALLEST_WEBHOOK_SECRET.
SMALLEST_WEBHOOK_ID=
SMALLEST_REQUEST_TIMEOUT_SECONDS=30

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
APP_ENV=development
# Railway injects RAILWAY_ENVIRONMENT_NAME. When it is "production", the app
# forces production security even if APP_ENV is missing or misspelled.
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000
BASE_URL=http://localhost:8000
# Refresh credentials are issued only as an HttpOnly cookie scoped to auth routes.
REFRESH_COOKIE_NAME=vai_refresh_token
# Temporary one-release bridge for sessions created before the cookie migration.
# Leave disabled unless deliberately preserving those existing browser sessions.
LEGACY_SESSION_MIGRATION_ENABLED=false
# App-wide ASGI body ceiling (8 MiB). Provider webhooks remain capped at 2 MiB.
MAX_REQUEST_BODY_BYTES=8388608
# Railway overwrites X-Real-IP at its public edge. Leave false elsewhere unless
# your deployment has an equivalent trusted header contract.
TRUST_RAILWAY_PROXY_HEADERS=false
