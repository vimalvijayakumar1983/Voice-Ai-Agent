# Database
DATABASE_URL=postgresql+asyncpg://voiceai:devpassword@localhost:5432/voiceai
DB_PASSWORD=devpassword

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM_NUMBER=

# Smallest.ai Atoms (server-side only; never expose this key in NEXT_PUBLIC_* variables)
SMALLEST_API_KEY=
SMALLEST_BASE_URL=https://api.smallest.ai/atoms/v1
SMALLEST_WEBHOOK_SECRET=
SMALLEST_DEFAULT_FROM_NUMBER=
SMALLEST_REQUEST_TIMEOUT_SECONDS=30

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000
BASE_URL=http://localhost:8000
