# Database
DATABASE_URL=postgresql+asyncpg://voiceai:devpassword@localhost:5432/voiceai
DB_PASSWORD=devpassword

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# Required as a separate, identical sealed value on API and worker in production.
# Blank uses SECRET_KEY only for backwards compatibility.
INTEGRATION_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT signing and verification are deliberately restricted to HS256.
ALGORITHM=HS256
# Development may use open. Production must use bootstrap or invite_only.
REGISTRATION_MODE=open
# Required and canonicalized when REGISTRATION_MODE=bootstrap; never exposed by the API/UI.
BOOTSTRAP_OWNER_EMAIL=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM_NUMBER=

# Smallest.ai Atoms (server-side only; never expose this key in NEXT_PUBLIC_* variables)
SMALLEST_API_KEY=
SMALLEST_BASE_URL=https://api.smallest.ai/atoms/v1
# Independent Waves API origin used for public voice catalog and previews.
SMALLEST_WAVES_BASE_URL=https://api.smallest.ai/waves/v1
SMALLEST_WEBHOOK_SECRET=
# Provider webhook ID whose secret matches SMALLEST_WEBHOOK_SECRET.
SMALLEST_WEBHOOK_ID=
SMALLEST_REQUEST_TIMEOUT_SECONDS=30

# VAV realtime speech providers (server-side only)
# Sarvam remains required for live transcription even when ElevenLabs is selected for speech.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_REQUEST_TIMEOUT_SECONDS=30
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_REQUEST_TIMEOUT_SECONDS=30

# Preferred production realtime lane: LiveKit carries SIP/media while VAV
# connects directly to Inworld for STT, Router LLM, and TTS.
INWORLD_API_KEY=
INWORLD_BASE_URL=https://api.inworld.ai
INWORLD_REQUEST_TIMEOUT_SECONDS=30
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=vav-inworld
LIVEKIT_NUM_IDLE_PROCESSES=1
# Optional frontend CSP origin for a self-hosted LiveKit deployment. LiveKit
# Cloud (*.livekit.cloud) is allowed automatically. Use only an exact trusted
# wss:// or https:// origin in production; never put API credentials here.
LIVEKIT_BROWSER_CONNECT_ORIGIN=
# Private HTTP origin of the LiveKit Agents service, including its Railway
# port. The API probes / and /worker; never expose this origin to the browser.
LIVEKIT_WORKER_HEALTH_URL=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
APP_ENV=development
# Railway injects RAILWAY_ENVIRONMENT_NAME. When it is "production", the app
# forces production security even if APP_ENV is missing or misspelled.
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000
BASE_URL=http://localhost:8000
# Refresh credentials are issued only as an HttpOnly cookie scoped to auth routes.
REFRESH_COOKIE_NAME=vai_refresh_token
# Temporary one-release bridge for sessions created before the cookie migration.
# Leave disabled unless deliberately preserving those existing browser sessions.
LEGACY_SESSION_MIGRATION_ENABLED=false
# App-wide ASGI body ceiling (8 MiB). Provider webhooks remain capped at 2 MiB.
MAX_REQUEST_BODY_BYTES=8388608
# Railway overwrites X-Real-IP at its public edge. Leave false elsewhere unless
# your deployment has an equivalent trusted header contract.
TRUST_RAILWAY_PROXY_HEADERS=false
